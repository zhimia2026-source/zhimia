{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhi.world/schemas/message-envelope-0.1.schema.json",
  "title": "ZHI Message Envelope v0.1",
  "type": "object",
  "required": ["protocol", "message_id", "conversation_id", "world_id", "sender", "recipient", "kind", "created_at", "payload", "policy"],
  "properties": {
    "protocol": { "const": "zhi-message/0.1" },
    "message_id": { "type": "string", "pattern": "^msg:[a-z0-9][a-z0-9._:-]{0,190}$" },
    "conversation_id": { "type": "string", "pattern": "^conv:[a-z0-9][a-z0-9._:-]{0,190}$" },
    "world_id": { "type": "string", "pattern": "^world:[a-z0-9][a-z0-9._:-]{0,190}$" },
    "sender": {
      "type": "object", "required": ["type", "id"],
      "properties": {
        "type": { "const": "agent" },
        "id": { "type": "string", "pattern": "^agent:[a-z0-9][a-z0-9._:-]{0,190}$" }
      },
      "additionalProperties": true
    },
    "recipient": {
      "type": "object", "required": ["type", "id"],
      "properties": {
        "type": { "const": "agent" },
        "id": { "type": "string", "pattern": "^agent:[a-z0-9][a-z0-9._:-]{0,190}$" }
      },
      "additionalProperties": true
    },
    "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
    "created_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reply_to": { "type": ["string", "null"], "pattern": "^msg:[a-z0-9][a-z0-9._:-]{0,190}$" },
    "payload": { "type": "object", "maxProperties": 64 },
    "policy": {
      "type": "object",
      "required": ["visibility", "retention"],
      "properties": {
        "visibility": { "const": "conversation_members" },
        "retention": { "const": "world_policy" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}